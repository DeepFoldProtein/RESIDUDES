Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.11.7
Stage: uv

# ---------------------------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.3-runtime-ubuntu24.04
Stage: final

%files from uv
    /uv /usr/local/bin/uv

%files
    ../../residudes-engine/core/pyproject.toml /opt/core/pyproject.toml
    ../../residudes-engine/core/uv.lock /opt/core/uv.lock
    install.sh /opt/trt-install.sh

%post
    sh /opt/trt-install.sh all      # one process: apptainer has no layers to split it into
    rm /opt/trt-install.sh

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/residudes-engine/src
    export RESIDUDES_ENGINE_CORE=/opt/residudes-engine/core

%runscript
    exec /opt/residudes-engine/bin/residudes-engine "$@"

%labels
    org.opencontainers.image.title RESIDUDES engine (PyTorch + TensorRT)
    org.opencontainers.image.description Protenix v2, OpenFold 3 and Boltz-2 on PyTorch or TensorRT 10.16. Checkpoints and the per-GPU TensorRT engines are bind-mounted.
    org.opencontainers.image.source https://github.com/DeepFoldProtein/RESIDUDES
    org.opencontainers.image.licenses MIT

%help
    Protenix v2, OpenFold 3 and Boltz-2, on PyTorch or TensorRT. Weights and engines are mounted:

        apptainer run --nv -B /path/to/repo/residudes-engine:/opt/residudes-engine \
                      -B /data/checkpoints:/ckpt -B /data/engines:/engines \
            residudes-engine-trt.sif predict --model pt2 --input input.json --out out/

    AlphaFold 3 runs in the JAX image; ESMFold2 in residudes-ef2.
