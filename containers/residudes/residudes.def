Bootstrap: docker
From: node:22-slim
Stage: node

# ---------------------------------------------------------------------------------------------
# molterm delegates every superposition to USalign, and without it the overlay figure is drawn
# from unaligned models. Its licence permits redistribution provided the notice travels with it.
Bootstrap: docker
From: gcc:14-bookworm
Stage: usalign

%post
    curl -fsSL "https://github.com/pylelab/USalign/archive/refs/tags/20260527.tar.gz" | tar -xz -C /tmp
    cd /tmp/USalign-20260527
    g++ -O3 -ffast-math -lm -o /usr/local/bin/USalign USalign.cpp
    install -D LICENSE /usr/local/share/USalign/LICENSE
    /usr/local/bin/USalign -h >/dev/null

# ---------------------------------------------------------------------------------------------
Bootstrap: docker
From: python:3.12-slim
Stage: final

%files from node
    /usr/local/bin/node /usr/local/bin/node
    /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

%files from usalign
    /usr/local/bin/USalign /usr/local/bin/USalign
    /usr/local/share/USalign/LICENSE /usr/local/share/USalign/LICENSE

%files
    # not /tmp: apptainer bind-mounts the host's /tmp over it before %post runs
    install.sh /opt/residudes-install.sh

%post
    ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
    sh /opt/residudes-install.sh
    rm /opt/residudes-install.sh

%environment
    export PYTHONPATH=/opt/residudes/src

%runscript
    exec /opt/residudes/bin/residudes "$@"

%labels
    org.opencontainers.image.title RESIDUDES agent
    org.opencontainers.image.description The CASP17 campaign agent: one dossier per target, from a sequence to a slate of five models, halting at the two human checkpoints. Mount the checkout and the work root.
    org.opencontainers.image.source https://github.com/DeepFoldProtein/RESIDUDES
    org.opencontainers.image.licenses MIT

%help
    The RESIDUDES campaign agent. Bind the checkout at /opt/residudes and the work root:

        apptainer run -B /path/to/repo/residudes:/opt/residudes -B /data/work:/data/work \
            residudes.sif doctor

    Schedulers (sbatch, pueue) and the predictors are not in here - see containers/README.md.
