Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.11.7
Stage: uv

# ---------------------------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.3-runtime-ubuntu24.04
Stage: final

%files from uv
    /uv /usr/local/bin/uv

%files
    ../../residudes-engine/core/jaxenv/pyproject.toml /opt/jaxenv/pyproject.toml
    ../../residudes-engine/core/jaxenv/uv.lock /opt/jaxenv/uv.lock
    ../../residudes-engine/core/models/alphafold3 /opt/models/alphafold3
    ../../residudes-engine/core/models/openfold-3 /opt/models/openfold-3
    install.sh /opt/jax-install.sh

%post
    sh /opt/jax-install.sh
    rm /opt/jax-install.sh

%environment
    export PATH=/opt/venv/bin:/opt/hmmer/bin:$PATH
    export PYTHONPATH=/opt/residudes-engine/src
    export RESIDUDES_ENGINE_CORE=/opt/residudes-engine/core

%runscript
    exec /opt/residudes-engine/bin/residudes-engine "$@"

%labels
    org.opencontainers.image.title RESIDUDES engine (JAX + AlphaFold 3)
    org.opencontainers.image.description AlphaFold 3 with its C++ extension already compiled, and the JAX backends. Contains vendored AlphaFold 3 code under CC BY-NC-SA 4.0: non-commercial. af3.bin is licensed per user and is bind-mounted.
    org.opencontainers.image.source https://github.com/DeepFoldProtein/RESIDUDES
    org.opencontainers.image.licenses CC-BY-NC-SA-4.0

%help
    AlphaFold 3 and the JAX backends. The parameters are licensed to you, so they are mounted:

        apptainer run --nv -B /path/to/repo/residudes-engine:/opt/residudes-engine \
                      -B /data/af3:/af3 \
                      --env RESIDUDES_ENGINE_AF3_WEIGHTS=/af3 \
            residudes-engine-jax.sif predict --model af3 --backend jax --input input.json

    The same image runs AlphaFold 3's data pipeline (`msa --source af3`), which needs the
    databases mounted as well.
