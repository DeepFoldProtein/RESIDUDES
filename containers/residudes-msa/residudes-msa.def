Bootstrap: docker
From: python:3.12-slim

%files
    install.sh /opt/msa-install.sh

%post
    sh /opt/msa-install.sh
    rm /opt/msa-install.sh

%environment
    export PYTHONPATH=/opt/residudes-engine/src

%runscript
    exec /opt/residudes-engine/bin/residudes-engine "$@"

%help
    HMMER, MMseqs2 and kalign for MSA search. The databases are bind-mounted:

        apptainer run -B /path/to/repo/residudes-engine:/opt/residudes-engine \
                      -B /gpfs/database/af3:/db \
            residudes-msa.sif msa --fasta q.fasta --source mmseqs2 --db /db

    `residudes-engine doctor` inside this image checks the tools and the databases it can see.
