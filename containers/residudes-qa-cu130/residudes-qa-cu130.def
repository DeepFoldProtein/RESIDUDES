Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.11.7
Stage: uv

# ---------------------------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.3-runtime-ubuntu24.04
Stage: final

%files from uv
    /uv /usr/local/bin/uv

%files
    ../../residudes-qa/pyproject.toml /opt/qa/pyproject.toml
    ../../residudes-qa/uv.lock /opt/qa/uv.lock
    install.sh /opt/qa-install.sh

%post
    sh /opt/qa-install.sh
    rm /opt/qa-install.sh

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/residudes-qa/src

%runscript
    exec /opt/venv/bin/python -m residudes_qa "$@"

%help
    residudes-qa with CUDA: the interface scorers, the GPU clustering, ProteinMPNN. Needs --nv:

        apptainer run --nv -B /path/to/repo/residudes-qa:/opt/residudes-qa qa-cu130.sif doctor

    Without a card, use the CPU image instead — it is a tenth of the size.
