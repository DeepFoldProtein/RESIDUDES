#!/usr/bin/env bash
# residudes-qa launcher: runs the CLI from the uv venv of this checkout (no install needed).
# Override the interpreter with RESIDUDES_QA_PYTHON (e.g. a venv built elsewhere).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="${RESIDUDES_QA_PYTHON:-${LANTERN_QA_PYTHON:-$HERE/.venv/bin/python}}"
if [ ! -x "$PY" ]; then
    echo "residudes-qa: no venv at $HERE/.venv — run: cd $HERE && uv sync --extra cu130   (cu124 for CUDA 12.4 drivers)" >&2
    exit 2
fi
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m residudes_qa "$@"
